# Copy to .env. Only needed to deploy to a real network (robinhoodChain in
# hardhat.config.js) -- not needed for `npx hardhat test`.
# NEVER commit .env -- it holds a private key.

# The wallet that will own InternStakingRewards (same wallet as
# intern-burn-bot's PRIVATE_KEY, since that bot needs to be the owner to
# call notifyRewardAmount). Needs a small amount of native ETH for gas.
PRIVATE_KEY=
