# Copy this file to .env and fill in real values.
# NEVER commit .env to git -- it holds real API keys and posting credentials.

# --- X (Twitter) API ---
#
# As of the 2026-02-06 pricing change, X moved new developers to
# pay-per-use credit pricing (the flat $200/mo "Basic" tier is legacy-only
# now). Relevant real costs as of 2026-09 (check developer.x.com/en/products/x-api
# for current numbers before relying on this):
#   - Posting: $0.015/post, or $0.20/post if the post contains a link.
#   - Reading (used by the search step below): $0.005/read, capped at
#     2M reads/month.
#   - 7-day recent search is included by default -- full-archive search
#     is Enterprise-only ($42k+/mo) and NOT needed here; this bot only
#     ever looks at recent/trending posts.
# At TARGET_COUNT=10 replies/hour with no links in the replies, that's
# roughly 10 * 24 * 30 * $0.015 = ~$108/month in posting cost, plus
# whatever the search step reads (see SEARCH_QUERY below) -- budget for
# that before turning DRY_RUN off.
#
# You need an X Developer account (developer.x.com) with a Project +
# App that has OAuth 1.0a "Read and Write" permissions, and that App's
# user context tokens generated for the account that should actually
# post (i.e. @Internburn_xyz itself, not a random dev account).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# App-only bearer token (same App as above) -- used for the read-only
# recent-search step. Cheaper/simpler than user-context for reads.
X_BEARER_TOKEN=

# --- Anthropic (comment generation) ---
# Same key already used by intern-site's Telegram bot / Rendo.
ANTHROPIC_API_KEY=

# --- Optional: xAI Grok Imagine (image/video generation for posts) ---
# Not required to run this bot in text-only mode. Set this once you've
# confirmed a real reference-to-video call against docs.x.ai works the
# way you expect -- see docs/x-growth-bot.md's note on this. Leave unset
# to skip media generation entirely (text-only replies).
XAI_API_KEY=

# --- Shared database (same Atlas cluster/URI as intern-site) ---
# Used for: dedupe (don't reply to the same post or same author twice
# within their cooldown windows) and a full audit log of every reply
# this bot ever sent -- real accountability trail for something running
# fully autonomously, even though nothing here waits for approval.
MONGODB_URI=

# --- Behavior ---

# How many top-engagement posts to consider per run.
TARGET_COUNT=10

# Search query for "trending crypto/AI-agent posts" -- tune this list.
# Recent-search syntax: OR between terms, -is:retweet to skip retweets,
# lang:en to keep replies coherent. Keep this broad; ranking by
# engagement (see lib/targets.js) is what narrows it to the top ones.
SEARCH_QUERY=(crypto OR "AI agent" OR "AI agents" OR web3 OR defi) -is:retweet lang:en

# Don't reply to the same author again within this many hours, even if
# they post something else trending -- avoids looking like a bot
# fixated on one account.
AUTHOR_COOLDOWN_HOURS=24

# Set to "true" to log everything (targets found, comment generated)
# WITHOUT actually posting to X. Always test with this on first --
# there is no "unpost" for a live reply once it's out.
DRY_RUN=true
