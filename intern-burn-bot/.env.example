# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it holds your private key.

# Robinhood Chain RPC
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# The wallet that LAUNCHED $INTERN on PAIR — only this wallet can claim
# creator fees, so it must also run this bot. Treat this key like a bank
# password. On Railway, set this as a secret environment variable, never
# in code or in a committed file.
PRIVATE_KEY=

# --- Fill these in once $INTERN is actually live on PAIR ---

# $INTERN token contract address
INTERN_TOKEN_ADDRESS=

# Tokenized Bloom Energy (BE) contract address — the pairing asset
BE_TOKEN_ADDRESS=

# PAIR's fee-claim contract for your token (get this from PAIR's docs or
# the creator dashboard once $INTERN is launched)
FEE_CLAIM_CONTRACT_ADDRESS=

# The Uniswap v4 router (or PAIR's own router, if they provide one) used
# to swap BE -> INTERN on the live pool
ROUTER_ADDRESS=

# Ops/marketing/expansion wallet. Receives the treasury cut of every claim,
# in BE, directly — no swap involved.
TREASURY_ADDRESS=

# The deployed InternStakingRewards contract address (see ../contracts).
# This bot deposits the 20% distribution cut here via notifyRewardAmount(),
# which streams it to everyone staking $INTERN, pro-rata and time-weighted.
# Deploy it first with: cd ../contracts && npx hardhat run scripts/deploy.js
DISTRIBUTOR_ADDRESS=

# --- Fee split (must sum to 100) ---

# % of every claimed BE fee that gets swapped for $INTERN and burned
BURN_PERCENT=70

# % deposited into DISTRIBUTOR_ADDRESS each run, streamed to staked
# $INTERN holders pro-rata over the contract's rewardsDuration
DISTRIBUTION_PERCENT=20

# % that goes straight to TREASURY_ADDRESS for ops/marketing/expansion
TREASURY_PERCENT=10

# --- Behavior ---

# Standard dead address — tokens sent here are unrecoverable
DEAD_ADDRESS=0x000000000000000000000000000000000000dEaD

# Don't bother swapping tiny fee amounts — wait until at least this much
# BE has accumulated (denominated in BE, e.g. 0.05)
MIN_BE_TO_SWAP=0.05

# Max acceptable slippage on the buyback swap, in percent
MAX_SLIPPAGE_PERCENT=3

# How often the bot runs, in minutes
RUN_INTERVAL_MINUTES=60

# Set to "true" to log every step WITHOUT sending real transactions.
# Always test with this on before flipping it off.
DRY_RUN=true
