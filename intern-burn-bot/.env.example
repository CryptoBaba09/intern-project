# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it holds your private key.

# Robinhood Chain RPC
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# The wallet that LAUNCHED $INTERN on PAIR — only this wallet can claim
# creator fees, so it must also run this bot. Treat this key like a bank
# password. On Railway, set this as a secret environment variable, never
# in code or in a committed file.
PRIVATE_KEY=

# --- $INTERN's own address — the one thing below that's genuinely ---
# --- unknowable until $INTERN actually launches on PAIR             ---

# $INTERN token contract address
INTERN_TOKEN_ADDRESS=

# --- Real PAIR protocol addresses on Robinhood Chain (verified against ---
# --- https://pair.fund/docs and each contract's source on Blockscout).  ---
# --- These already default to correct values in lib/config.js — only    ---
# --- set them here if you need to override (e.g. PAIR ships a new       ---
# --- version). Shown here for visibility, not because they're required. ---

# Tokenized Bloom Energy (BE) — the pairing asset. Already a live,
# established PAIR quote asset independent of $INTERN's own launch.
# Default: 0x822cC93fFD030293E9842C30bBD678f530701867
BE_TOKEN_ADDRESS=

# PairV4Locker — holds every launch's locked position and claimable
# creator/protocol fee balances. One contract for the whole protocol.
# Default: 0xeFcF476E8870fB3eb8680f039414fdcCE6C2a117
FEE_CLAIM_CONTRACT_ADDRESS=

# PairV5MultiPoolAggregator — PAIR's integrator-facing swap contract
# (buyExactInput/sellExactInput). Deliberately not the raw Uniswap V4
# Universal Router — PAIR's docs warn the Robinhood-deployed router uses a
# non-standard struct field, and the aggregator exists so integrators
# don't have to hand-encode that themselves.
# Default: 0x9d7741776098aFA315e4D576ede4F2c67a21d8Ce
ROUTER_ADDRESS=

# PairLaunchpadV5Upgradeable (proxy) — used to read $INTERN's pool info
# (position id, fee tier, tick spacing, hook) at runtime.
# Default: 0x8660A7F019C7943b0b0A91B8E39AFf3b6DB6Ae62
LAUNCHPAD_ADDRESS=

# V4Quoter — used to get a real pre-trade quote for slippage protection.
# Default: 0x8Dc178eFB8111BB0973Dd9d722ebeFF267c98F94
QUOTER_ADDRESS=

# --- Your own wallets ---

# Ops/marketing/expansion wallet. Receives the treasury cut of every claim,
# in BE, directly — no swap involved.
TREASURY_ADDRESS=

# The deployed InternStakingRewards contract address (see ../contracts).
# This bot deposits the 20% distribution cut here via notifyRewardAmount(),
# which streams it to everyone staking $INTERN, pro-rata and time-weighted.
# Deploy it first with: cd ../contracts && npx hardhat run scripts/deploy.js
DISTRIBUTOR_ADDRESS=

# --- Fee split (must sum to 100) ---

# % of every claimed BE fee that gets swapped for $INTERN and burned
BURN_PERCENT=70

# % deposited into DISTRIBUTOR_ADDRESS each run, streamed to staked
# $INTERN holders pro-rata over the contract's rewardsDuration
DISTRIBUTION_PERCENT=20

# % that goes straight to TREASURY_ADDRESS for ops/marketing/expansion
TREASURY_PERCENT=10

# --- Behavior ---

# Standard dead address — tokens sent here are unrecoverable
DEAD_ADDRESS=0x000000000000000000000000000000000000dEaD

# Don't bother swapping tiny fee amounts — wait until at least this much
# BE has accumulated (denominated in BE, e.g. 0.05)
MIN_BE_TO_SWAP=0.05

# Max acceptable slippage on the buyback swap, in percent
MAX_SLIPPAGE_PERCENT=3

# How often the bot runs, in minutes
RUN_INTERVAL_MINUTES=60

# Set to "true" to log every step WITHOUT sending real transactions.
# Always test with this on before flipping it off.
DRY_RUN=true
