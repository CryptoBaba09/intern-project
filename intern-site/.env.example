# Copy to .env.local for local dev, or set these in Vercel's Environment
# Variables (Project Settings -> Environment Variables). Everything here
# is NEXT_PUBLIC_ -- these are exposed to the browser, so never put a
# secret in this file. (Real secrets like the bot's PRIVATE_KEY live in
# intern-burn-bot/.env / Railway, never here.)

# From https://cloud.reown.com (free signup) -- needed for WalletConnect
# and any wallet that connects through it. Injected wallets (MetaMask,
# Coinbase Wallet's extension, etc.) still work without this, since they
# don't go through WalletConnect's relay.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Leave all three blank until $INTERN is actually live -- the site
# detects that and shows "coming soon" states instead of calling contract
# methods against empty addresses.
NEXT_PUBLIC_INTERN_TOKEN_ADDRESS=
NEXT_PUBLIC_BE_TOKEN_ADDRESS=
# The deployed InternStakingRewards contract (see ../contracts)
NEXT_PUBLIC_DISTRIBUTOR_ADDRESS=

# Direct link to $INTERN's pool on PAIR. Leave blank pre-launch -- the
# buy button shows "trading opens at launch" instead of a dead link.
NEXT_PUBLIC_PAIR_POOL_URL=
